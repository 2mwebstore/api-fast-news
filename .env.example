# API service configuration.
#
# Copy to backend/.env and fill in. Every value here has a safe development
# default except the secrets, which are blank on purpose — the server refuses to
# start in production without them rather than falling back to something guessable.
#
# On a managed platform (Railway, Render, Fly) set these as service variables
# instead of shipping a file. See docs/RAILWAY.md.
#
# PORT is injected by those platforms and is read in preference to APP_PORT.
# DATABASE_URL, if set, wins over the five DATABASE_* values below.

# ─── App ────────────────────────────────────────────────────────────────
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8080
APP_PORT=8080
SITE_NAME=Cambodia Fast News
SITE_NAME_KH=ព័ត៌មានលឿនរហ័សកម្ពុជា

# ─── MySQL ──────────────────────────────────────────────────────────────
# MYSQL_HOST_PORT is the port docker-compose publishes on the host. Change it
# if you already run MySQL on 3306; DATABASE_PORT must match it for local runs.
MYSQL_HOST_PORT=3307
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=fast-news

# ─── Redis ──────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ─── Auth ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# ─── Cloudflare R2 (S3-compatible) ──────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ─── Settings encryption ────────────────────────────────────────────────
# Encrypts credentials saved from Admin → Settings (such as the Telegram bot
# token) before they are written to the database. Keep it separate from
# JWT_SECRET: rotating the JWT secret would otherwise make saved credentials
# unreadable and they would have to be re-entered.
# Generate with: openssl rand -base64 48
SETTINGS_KEY=

# ─── Telegram ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_AUTO_PUBLISH=false

# ─── Web Push (VAPID) ───────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=

# ─── AI (Anthropic) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_ENABLED=true

# ─── Rate limiting (per client IP, per minute) ──────────────────────────
# One page view costs several API calls: the homepage alone fetches the nav,
# breaking bar, hero, feed, trending, pulse and video rail, and each ad slot
# requests its own creative. A read ceiling that looks generous per request is
# not generous per reader, so these are set per class of endpoint.
#
# `npm run dev` has no ISR caching, so every navigation and every link prefetch
# re-renders server-side and repeats those calls. Development legitimately
# needs more headroom than production.
RATE_LIMIT_PUBLIC_PER_MIN=1200
RATE_LIMIT_ADS_PER_MIN=300
RATE_LIMIT_BEACON_PER_MIN=600
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_AI_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_MIN=30

# ─── Demo seed imagery ──────────────────────────────────────────────────
# "photo" uses real photographs from Lorem Picsum (Unsplash-sourced, licensed
# for this use), seeded per article so they stay stable across reseeds.
# "svg" uses self-contained inline graphics that need no network — for CI,
# air-gapped installs, or when the seed must make no outbound requests.
# Either way these are decorative placeholders: each demo article carries a
# caption saying the image does not depict the event. Replace them with real
# licensed photographs through the media library before publishing.
SEED_IMAGE_SOURCE=photo

# ─── Trusted proxies ────────────────────────────────────────────────────
# CIDRs whose forwarding headers (X-CFN-Client-IP, CF-Connecting-IP,
# X-Forwarded-For) may be believed. Requests from anywhere else are attributed
# to the address that actually connected, so a client cannot claim someone
# else's IP to get a fresh quota or exhaust theirs.
# Empty uses the default: loopback plus the private ranges where the Nuxt
# server and Cloudflare's tunnel sit.
TRUSTED_PROXIES=

# ─── CORS ───────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── First-run administrator (seed only) ────────────────────────────────
# If ADMIN_PASSWORD is unset, the seeder generates one and prints it once.
ADMIN_EMAIL=admin@cambodiafastnews.local
ADMIN_PASSWORD=
